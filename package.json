{
  "name": "fraudshield-monorepo",
  "version": "1.0.0",
  "description": "Unified FraudShield Platform",
  "private": true,
  "scripts": {
    "setup": "npm install && npm install --prefix Backend && npm install --prefix Frontend",
    "install:all": "npm install && npm install --prefix Backend && npm install --prefix Frontend",
    "dev:frontend": "npm run dev --prefix Frontend",
    "dev:backend": "npm run dev --prefix Backend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev",
    "build": "npm run build --prefix Frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
